# ============================================================
# AnswerDesk AI 環境変数サンプル
# コピーして .env を作成してください
# ============================================================

# App
APP_ENV=dev
APP_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:5173
LOG_LEVEL=INFO

# Database (docker-compose のデフォルト)
DATABASE_URL=postgresql://answerdesk:answerdesk@db:5432/answerdesk

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_REQUEST_TIMEOUT_SECONDS=30

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=86400
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# AWS
AWS_REGION=ap-northeast-1
S3_BUCKET_NAME=answerdesk-dev-documents
SQS_QUEUE_URL=

# Upload
MAX_UPLOAD_FILE_SIZE_MB=20
ALLOWED_UPLOAD_MIME_TYPES=application/pdf

# RAG
VECTOR_TOP_K=5
RAG_SCORE_THRESHOLD=0.75

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8000

# Seed (省略時はデフォルト値を使用)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=changeme1234
SEED_ADMIN_NAME=Admin
